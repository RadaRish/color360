{
  "apps": [
    {
      "name": "color360-app",
      "script": "server.js",
      "cwd": "/var/www/color360",
      "instances": 1,
      "exec_mode": "fork",
      "watch": false,
      "max_memory_restart": "1G",
      "env": {
        "NODE_ENV": "production",
        "PORT": "3000",
        "LAMA_PORT": "5000",
        "LAMA_HOST": "127.0.0.1"
      },
      "env_production": {
        "NODE_ENV": "production",
        "PORT": "3000",
        "LAMA_PORT": "5000",
        "LAMA_HOST": "127.0.0.1"
      },
      "log_date_format": "YYYY-MM-DD HH:mm Z",
      "error_file": "/var/log/pm2/color360-error.log",
      "out_file": "/var/log/pm2/color360-out.log",
      "log_file": "/var/log/pm2/color360-combined.log"
    },
    {
      "name": "color360-lama",
      "script": "python3",
      "args": "app.py",
      "cwd": "/var/www/color360/lama",
      "instances": 1,
      "exec_mode": "fork",
      "watch": false,
      "max_memory_restart": "2G",
      "interpreter": "none",
      "env": {
        "PORT": "5000",
        "HOST": "127.0.0.1",
        "PYTHONPATH": "/var/www/color360/lama",
        "PYTHONUNBUFFERED": "1"
      },
      "env_production": {
        "PORT": "5000",
        "HOST": "127.0.0.1",
        "PYTHONPATH": "/var/www/color360/lama",
        "PYTHONUNBUFFERED": "1"
      },
      "log_date_format": "YYYY-MM-DD HH:mm Z",
      "error_file": "/var/log/pm2/lama-error.log",
      "out_file": "/var/log/pm2/lama-out.log",
      "log_file": "/var/log/pm2/lama-combined.log"
    }
  ]
}