# Production Environment Variables for Color360
# Копируйте этот файл в .env и измените значения для вашего сервера

# Server Configuration
NODE_ENV=production
PORT=3000
DOMAIN=www.color360.ru

# Security - ОБЯЗАТЕЛЬНО измените в продакшене!
JWT_SECRET=your-super-secure-jwt-secret-key-here-change-this-in-production
SESSION_SECRET=your-super-secure-session-secret-key-here-change-this-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=3600000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# LaMa AI Service Configuration
LAMA_PORT=8080
LAMA_HOST=127.0.0.1
LAMA_URL=http://127.0.0.1:8080

# File Upload Configuration
MAX_FILE_SIZE=50MB
MAX_FILES_PER_REQUEST=10
UPLOAD_DIR=./uploads

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=./logs

# CORS Configuration
CORS_ORIGINS=http://color360.ru,https://color360.ru,http://www.color360.ru,https://www.color360.ru

# Admin Configuration (изменить в продакшене!)
ADMIN_EMAIL=admin@color360.ru
ADMIN_PASSWORD=change-this-secure-password-in-production

# Упрощён: удалены неиспользуемые DIRECTORIES/OLD_INSTALL/monitoring переменные